# --- OfficeChat server ---
PORT=8787
HOST=0.0.0.0

# Simple private-team access gate. CHANGE THIS before deploying.
# The server never sends this value back to clients.
OFFICE_CODE=CHANGE_ME

# SQLite database file (created automatically if missing).
DATABASE_PATH=./data/officechat.db

# Log message content in dev only. Never enable in production.
LOG_MESSAGE_CONTENT=false

NODE_ENV=development

# --- Desktop (apps/desktop/.env) ---
# VITE_WS_URL=ws://localhost:8787
# VITE_GIPHY_API_KEY=

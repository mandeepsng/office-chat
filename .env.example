# --- OfficeChat server ---
PORT=8787
HOST=0.0.0.0

# Simple private-team access gate. CHANGE THIS before deploying.
# The server never sends this value back to clients.
OFFICE_CODE=CHANGE_ME

# SQLite database file (created automatically if missing).
DATABASE_PATH=./data/officechat.db

# Where pasted/uploaded images are stored (created automatically if missing).
FILES_PATH=./data/files
# Max accepted upload size in bytes (clients also downscale before sending).
MAX_UPLOAD_BYTES=8388608

# Log message content in dev only. Never enable in production.
LOG_MESSAGE_CONTENT=false

NODE_ENV=development

# --- Desktop (apps/desktop/.env) ---
# VITE_WS_URL=ws://localhost:8787
# HTTP base for image upload/serving; defaults to VITE_WS_URL with http(s).
# VITE_HTTP_URL=http://localhost:8787
# VITE_GIPHY_API_KEY=
# VITE_YOUTUBE_API_KEY=

# WebSocket server URL. Do not hardcode localhost for production builds.
#   dev:  ws://localhost:8787
#   prod: wss://chat.example.com
VITE_WS_URL=ws://localhost:8787

# Optional. Enables the GIF picker when set. Get a key at developers.giphy.com.
VITE_GIPHY_API_KEY=

# Optional. Enables YouTube search when set. Create a YouTube Data API v3 key
# in Google Cloud Console (console.cloud.google.com).
VITE_YOUTUBE_API_KEY=

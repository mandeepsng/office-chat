PORT=8787
HOST=0.0.0.0

# Simple private-team access gate. CHANGE THIS before deploying.
OFFICE_CODE=CHANGE_ME

# SQLite file (created automatically). Use ":memory:" for an ephemeral DB.
DATABASE_PATH=./data/officechat.db

# Log message content (dev only; never enable in production).
LOG_MESSAGE_CONTENT=false

# Server-side link-preview (unfurl) cards. Set to "false" to disable.
LINK_PREVIEWS_ENABLED=true
# How long a fetched preview is cached before refetching.
LINK_PREVIEW_TTL_DAYS=7

NODE_ENV=development
